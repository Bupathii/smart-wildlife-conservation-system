# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/wildlife-conservation

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS - comma separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# File uploads (local storage for prototype)
UPLOAD_DIR=uploads
